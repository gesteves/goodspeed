# URL of the worker's published JSON feed (latest.json).
#
# Production: the public S3/CDN URL of latest.json.
# Local dev:  a filesystem path to a feed produced by the worker, e.g.
#             ../output/latest.json -- generate it first with:
#               cd ../worker && uv sync && uv run python -m goodspeed.main run --out-dir ../output
#
# fetchFeed() accepts an http(s) URL, a file: URL, or a plain path.
GOODSPEED_FEED_URL=../output/latest.json

# URL of the worker's gridded field feed for the bay map (field-latest.json).
# Same rules as GOODSPEED_FEED_URL: http(s) URL, file: URL, or filesystem
# path. Optional -- if unset or the fetch fails, the map section just doesn't
# render and the rest of the dashboard is unaffected.
GOODSPEED_FIELD_FEED_URL=../output/field-latest.json

# Mapbox GL JS access token (public-by-design but should be URL-restricted in
# the Mapbox dashboard to the production domain + localhost + Netlify deploy
# previews). Required to render the bay map; without it the map falls back to
# a no-tiles placeholder.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Future: Google Weather & Air-Quality API key. Server-only -- never prefix
# with NEXT_PUBLIC_, never import into a Client Component.
# GOOGLE_API_KEY=
