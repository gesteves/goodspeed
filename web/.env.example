# URL of the API's published JSON feed (latest.json).
#
# Production: the Fly app serves it directly:
#             https://[app-name].fly.dev/latest.json
# Local dev:  a filesystem path to a feed produced by the API, e.g.
#             ../output/latest.json -- generate it first with:
#               cd ../api && uv sync && uv run python -m goodspeed.main run --out-dir ../output
#
# fetchFeed() accepts an http(s) URL, a file: URL, or a plain path.
GOODSPEED_FEED_URL=../output/latest.json

# URL of the API's gridded field feed for the bay map (field-latest.json).
# Same rules as GOODSPEED_FEED_URL: http(s) URL, file: URL, or filesystem
# path. Optional -- if unset or the fetch fails, the map section just doesn't
# render and the rest of the dashboard is unaffected.
# Production: https://[app-name].fly.dev/field-latest.json
GOODSPEED_FIELD_FEED_URL=../output/field-latest.json

# Mapbox GL JS access token (public-by-design but should be URL-restricted in
# the Mapbox dashboard to the production domain + localhost + Netlify deploy
# previews). Required to render the bay map; without it the map falls back to
# a no-tiles placeholder.
# PUBLIC_MAPBOX_TOKEN=

# Mapbox Static Images API token, read by the OG-image edge function
# (netlify/edge-functions/og.tsx). Must NOT be URL-restricted: the request
# runs server-side from Netlify's edge, so there's no Referer/Origin for
# Mapbox to match against and a URL-restricted token will 403. Optional --
# without it /og.png 404s and share previews fall back to no image.
# MAPBOX_STATIC_TOKEN=

# Plausible script ID (the filename Plausible serves, without the `.js`).
# Public by design -- it's emitted into the page HTML. Optional: if unset,
# the analytics shim and script tag are skipped entirely, which is what you
# usually want locally. Set this in the Netlify dashboard for production.
# The /js/* rewrite in netlify.toml proxies whatever ID you set here, so no
# config change is needed when the ID rotates.
# PUBLIC_PLAUSIBLE_SCRIPT_ID=
