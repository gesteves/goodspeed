{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.astro",
    ".astro/types.d.ts",
    "src/env.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".netlify"]
}
