---
/**
 * Custom 500 page. Astro renders this automatically when an SSR exception
 * escapes a page's frontmatter -- e.g. `getDashboardData()` throws because
 * both the upstream feed and the in-memory fallback cache are unavailable.
 * Middleware has already run, so the saved theme is applied.
 */
import Layout from "@/layouts/Layout.astro";
import errorStyles from "@/styles/dashboard-error.module.css";
---

<Layout title="Conditions unavailable">
  <div class={errorStyles.wrap}>
    <div class={errorStyles.card}>
      <h1 class={errorStyles.title}>Conditions unavailable</h1>
      <p class={errorStyles.body}>
        The feed couldn&rsquo;t be loaded right now. This usually clears up on
        its own — the data refreshes a few times a day.
      </p>
      <a class={errorStyles.button} href="/">Try again</a>
    </div>
  </div>
</Layout>
