---
/**
 * Custom 404 page. Astro serves this for any unmatched route. Reuses the same
 * `dashboard-error.module.css` card styling as the SSR 500 and the in-island
 * error boundary fallback so the three error surfaces look identical.
 */
import Layout from "@/layouts/Layout.astro";
import errorStyles from "@/styles/dashboard-error.module.css";
---

<Layout title="Page not found">
  <div class={errorStyles.wrap}>
    <div class={errorStyles.card}>
      <h1 class={errorStyles.title}>Page not found</h1>
      <p class={errorStyles.body}>
        That page doesn&rsquo;t exist. The dashboard lives at the root.
      </p>
      <a class={errorStyles.button} href="/">Go to the dashboard</a>
    </div>
  </div>
</Layout>
