---
import Layout from "@/layouts/Layout.astro";
import { Dashboard } from "@/components/Dashboard";
import { getDashboardDataPointOnly } from "@/lib/data-source";

const { feed, field, fieldStatus } = await getDashboardDataPointOnly();
const { theme, units } = Astro.locals;

// Edge-cache the HTML at Netlify's CDN. Mirrors `/dashboard.json` so the page
// and its polling endpoint stay in lockstep on freshness. The browser must
// always revalidate (no stale local copy is OK); the edge serves the response
// for up to 5 min with a 10-min stale-while-revalidate window so a slow or
// momentarily unavailable origin doesn't show up as a slow first byte.
// `Vary: Cookie` keeps the per-cookie variants (theme, units) correct.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, must-revalidate",
);
Astro.response.headers.set(
  "Netlify-CDN-Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=600",
);
Astro.response.headers.set("Vary", "Cookie");
---

<Layout initialTheme={theme}>
  <div class="page">
    <a href="#main" class="skipLink">Skip to main content</a>
    <main id="main" class="main">
      <Dashboard
        client:load
        initialData={{ feed, field, fieldStatus }}
        initialTheme={theme}
        initialUnits={units}
      />
      <footer class="footer">
        The data presented here is based on a hydrodynamic model provided by the National Oceanic and Atmospheric Administration’s San Francisco Bay Operational Forecast
        System. These are computed-generated forecasts, not measurements, and are presented here for informational purposes only. Use at your own&nbsp;risk.<br>
        <a href="https://tidesandcurrents.noaa.gov/ofs/ofs_station.html?stname=SW%20of%20AI&ofs=sfb&stnid=SFB1204&subdomain=en" target="_blank">Source Data</a> · <a href="https://github.com/gesteves/goodspeed/" target="_blank">GitHub</a> · All times Pacific
      </footer>
    </main>
  </div>
</Layout>

<style>
  .page {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 18px 14px 40px;
    /* Safety net against sub-pixel chart/axis bleed on narrow viewports. */
    overflow-x: hidden;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 26px;
    width: 100%;
    max-width: 880px;
    /* Allow the column to shrink below its charts' intrinsic width. */
    min-width: 0;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding-top: 14px;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  /* Keyboard skip link: invisible until focused, slides in from the top edge. */
  .skipLink {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    padding: 8px 12px;
    border-radius: 0 0 var(--radius-sm) 0;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-110%);
    transition: transform 0.12s ease;
  }

  .skipLink:focus,
  .skipLink:focus-visible {
    transform: translateY(0);
  }

  @media (min-width: 700px) {
    .page {
      padding: 32px 24px 56px;
    }

    .main {
      gap: 30px;
    }
  }
</style>
