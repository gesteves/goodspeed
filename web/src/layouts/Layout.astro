---
/**
 * Root HTML shell for every page.
 *
 * Responsibilities, in order:
 *  1. Inline the Geist + Geist Mono variable fonts and the global CSS so the
 *     first paint already has the right typography (no FOUT).
 *  2. Render the document <head> with title/description + Open Graph metadata.
 *     The OG image is rendered by `netlify/functions/og.mts` at `/images/og.png`.
 *  3. Apply the saved theme synchronously via the inline `is:inline` script
 *     reading the `gs-theme` cookie. Pages are prerendered, so middleware can't
 *     do this -- the inline script is what avoids a light-on-dark flash.
 *  4. Preload `/dashboard.json` so the browser is already fetching it before
 *     the Dashboard island's JS has parsed.
 *  5. Inject Plausible analytics (queued via shim so `plausible(...)` calls
 *     never lose events) when `PUBLIC_PLAUSIBLE_SCRIPT_ID` is set. Both tags
 *     are skipped in local dev / preview builds so they don't 404.
 *
 * The body is a single `<slot />` -- pages own their own structure.
 */
import "@fontsource-variable/geist/index.css";
import "@fontsource-variable/geist-mono/index.css";
import "@/styles/globals.css";
import { PUBLIC_PLAUSIBLE_SCRIPT_ID } from "astro:env/client";

interface Props {
  title?: string;
  description?: string;
  /** Emit `<meta name="robots" content="noindex">` (e.g. the /race-day deep link). */
  noindex?: boolean;
}

const {
  title = "Alcatraz Swim Conditions",
  description = "Modeled water temperature, currents, tide, and wind near Alcatraz Island, San Francisco Bay.",
  noindex = false,
} = Astro.props;

// Absolute URLs for share metadata. `Astro.site` is sourced from the
// `site` config in `astro.config.mjs`, which reads `process.env.URL` at build
// time so the value follows the Netlify deploy (production, branch, deploy
// preview) automatically.
//
// `?v=<hour>` busts the cache scrapers (Slack/iMessage/etc.) hold for an
// og:image URL: it rotates so a stale share card picks up a fresh render, but
// stays constant otherwise so concurrent unfurls share one `durable`-cached
// render instead of each triggering a new one. The field feed is hourly, and
// the OG picks the frame *nearest* now -- so the image changes once an hour, on
// the half-hour. `round` (not `floor`) flips the version on that same boundary,
// so the URL changes exactly when the rendered image does.
const ogImage = new URL("/images/og.png", Astro.site);
ogImage.searchParams.set("v", String(Math.round(Date.now() / 3_600_000)));
const ogImageUrl = ogImage.toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Map of central San Francisco Bay near Alcatraz Island showing modeled water currents as arrows colored by water temperature, with the Escape from Alcatraz swim start and finish marked."
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#e9eef2"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0b1117"
    />
    <link rel="icon" href="/favicon.ico" />

    {/*
      Flash-free theme: read the `gs-theme` cookie and apply `data-theme`
      synchronously before the browser paints. Pages are prerendered, so
      middleware can't do this on the server -- this inline script is the
      single source of truth for the initial theme attribute.
    */}
    <script is:inline>
      (function () {
        try {
          const match = document.cookie.match(/(?:^|;\s*)gs-theme=([^;]+)/);
          if (!match) return;
          const value = decodeURIComponent(match[1]);
          if (value === "light" || value === "dark") {
            document.documentElement.setAttribute("data-theme", value);
          }
        } catch {
          /* ignore: theme stays at the CSS default */
        }
      })();
    </script>

    {/*
      Preload the dashboard JSON so the browser begins the request before the
      JS bundle has parsed. The Dashboard island's `useEffect` will pick up
      the in-flight response.
    */}
    <link
      rel="preload"
      href="/dashboard.json"
      as="fetch"
      crossorigin="anonymous"
    />

    {/*
      Plausible analytics, proxied through Netlify (see netlify.toml). The
      script and event endpoint are served from this domain so ad blockers
      don't drop them, while data still lands at plausible.io.
      The inline queueing shim sets up plausible() before the real script
      arrives, so call order is safe regardless of load timing.
      Both tags are skipped when PUBLIC_PLAUSIBLE_SCRIPT_ID is unset so local
      dev / preview builds don't 404 on a missing script.
    */}
    {PUBLIC_PLAUSIBLE_SCRIPT_ID && (
      <>
        <script is:inline>
          window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments) };
          plausible.init = plausible.init || function (i) { plausible.o = i || {} };
          plausible.init({ endpoint: '/api/event' });
        </script>
        <script is:inline defer src={`/js/${PUBLIC_PLAUSIBLE_SCRIPT_ID}.js`}></script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
