# Build context is the REPO ROOT for the api image (it COPYs both api/ and
# schema/), so deploy from the root:
#
#   fly deploy --config api/fly.toml --dockerfile api/Dockerfile
#
# Running it from inside api/ makes api/ the context, which both skips this
# file (Docker reads .dockerignore from the context root) and breaks the
# COPY paths in api/Dockerfile.
#
# Keep the context small.

**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.venv/
.git/
.gitignore
.github/
output/
api/output/

# Tests + fixtures don't need to be in the image.
api/tests/

# The web app is irrelevant to the api image.
web/
.netlify/

# Local dev data, docs, editor config — none of it is COPYed.
data/
**/CLAUDE.md
**/README.md
.claude/

# OS / editor
.DS_Store
.idea/
.vscode/
